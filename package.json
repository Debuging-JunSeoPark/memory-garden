{
  "name": "memory-garden",
  "version": "0.0.0",
  "private": false,
  "description": "A game-like 3D diary that grows memories into a personal garden.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "agent:hook": "node agents/hooks/runner.js",
    "agent:server": "node agents/server-agent/src/index.js",
    "test": "vitest run",
    "test:repo": "vitest run tests/repository/validate-repository.test.mjs",
    "validate:repo": "node scripts/validate-repository.mjs",
    "verify:repo": "pnpm test:repo && pnpm validate:repo",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,md,json}\"",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm validate:repo && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.187.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "src/**/*.{css,md,json}": "prettier --write"
  }
}
